{
  "name": "@nota-lawyer/shared",
  "version": "0.1.0",
  "description": "Shared utilities for the Nota.Lawyer platform — auth, payments, LLM, Bright Data, types",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "default": "./dist/auth.js"
    },
    "./stripe": {
      "types": "./dist/stripe.d.ts",
      "default": "./dist/stripe.js"
    },
    "./llm": {
      "types": "./dist/llm.d.ts",
      "default": "./dist/llm.js"
    },
    "./bright-data": {
      "types": "./dist/bright-data.d.ts",
      "default": "./dist/bright-data.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@speechmatics/auth": "^0.1.0",
    "@supabase/supabase-js": "^2.45.0",
    "algoliasearch": "^5.52.1",
    "neo4j-driver": "^6.0.1",
    "openai": "^4.65.0",
    "storyblok-js-client": "^7.6.0",
    "stripe": "^17.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/pg": "^8.20.0",
    "pg": "^8.21.0",
    "tsx": "^4.22.3",
    "typescript": "^5.6.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "restricted"
  }
}
