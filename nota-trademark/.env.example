# ============================================================
#  Nota.Lawyer - Trademark app environment variables
#  Copy to .env.local and fill in real values
# ============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...
SUPABASE_SERVICE_ROLE_KEY=ey...   # NEVER expose to browser

# --- Stripe (test mode for the hackathon) ---
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...   # from dashboard.stripe.com/test/webhooks

# --- LLM ---
# Set to "groq" for the demo/production. "ollama" for local dev on Johnson.
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...               # from console.groq.com/keys
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://192.168.1.161:11434/v1
OLLAMA_MODEL=qwen3:32b

# --- Web data provider ---
# Flip between "brightdata" and "nimble" depending on which hackathon
# you're demoing to. Both providers do the same job; the conflict-agent
# code path is identical.
WEB_DATA_PROVIDER=brightdata

# Bright Data settings (used when WEB_DATA_PROVIDER=brightdata)
# Required for: Bright Data UNLOCKED hackathon + HackerNoon Proof of Usefulness
BRIGHT_DATA_API_TOKEN=...          # from brightdata.com Dashboard -> API Tokens
BRIGHT_DATA_WEB_UNLOCKER_ZONE=mcp_unlocker
BRIGHT_DATA_SERP_ZONE=serp

# Nimble settings (used when WEB_DATA_PROVIDER=nimble)
# Required for: DWNY Nimble track submission
# Nimble uses HTTP Basic auth - email + password, not API tokens
NIMBLE_EMAIL=...
NIMBLE_PASSWORD=...
