# Lex.NY environment variables — example template.
# Copy to nota-lex/.env.local and fill in your own keys.
# NEVER commit .env.local — it contains real credentials.

# ===================== Database (local Postgres 18 + pgvector 0.8.2) =====================
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=changeme
PGDATABASE=lex

# ===================== LLM (Groq Llama 3.3 70B) =====================
# Get free key at https://console.groq.com
GROQ_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# ===================== Embeddings (local Ollama) =====================
# Install Ollama at https://ollama.com, then: ollama pull mxbai-embed-large
OLLAMA_EMBED_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=mxbai-embed-large

# ===================== Bright Data (HACKATHON SPONSOR — required) =====================
# Get API token at https://brightdata.com/cp/setting/users (create a Web Unlocker zone)
BRIGHT_DATA_API_TOKEN=
BRIGHT_DATA_WEB_UNLOCKER_ZONE=mcp_unlocker
BRIGHT_DATA_SERP_ZONE=mcp_unlocker
WEB_DATA_PROVIDER=brightdata

# ===================== Neo4j AuraDB (HACKATHON SPONSOR — optional but adds GraphRAG) =====================
# Get free instance at https://console.neo4j.io
# When unset, /api/ask still works — graph augmentation is skipped gracefully.
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ===================== Algolia (HACKATHON SPONSOR — optional federated search) =====================
# Get free Build tier at https://www.algolia.com
ALGOLIA_APP_ID=
ALGOLIA_ADMIN_API_KEY=
ALGOLIA_SEARCH_API_KEY=
ALGOLIA_INDEX_NAME=lex_ny_statutes

# ===================== Storyblok (HACKATHON SPONSOR - headless CMS) =====================
# 45-day Growth+ trial at https://www.storyblok.com
#
# Where to get the token (this tripped us up - documenting for posterity):
#   - If you ran `npx storyblok create --token <PAT>`, that PAT is your CDN token.
#   - Otherwise: Storyblok app -> your space -> Settings -> Access Tokens.
#     Use the "Public" or "Preview" token. NOT the OAuth/Management/Admin API tokens
#     (those go through https://mapi.storyblok.com with Authorization header, not the CDN).
#
# Quick sanity check: the working token returns HTTP 200 from
#   curl "https://api.storyblok.com/v2/cdn/stories?token=$TOKEN&version=draft&per_page=1"
#
# Region: api.storyblok.com is EU; api-us.storyblok.com is US.
# This integration assumes EU; flip the base URL in storyblok-client.ts if you signed up in US.
STORYBLOK_ACCESS_TOKEN=
STORYBLOK_SPACE_ID=
# Use "draft" to see unpublished content, "published" for live-only.
STORYBLOK_VERSION=draft
# ===================== Source data APIs (all free) =====================
# CourtListener — free tier 5 req/min on opinion endpoints (May 2026)
# https://www.courtlistener.com/help/api/rest/
COURTLISTENER_API_TOKEN=

# NY Senate OpenLegislation — free, register at https://legislation.nysenate.gov/static/docs/html/index.html
NY_SENATE_API_KEY=

# =====================================================================
#  NEW HACKATHON PARTNERS (added May 27 to Bright Data UNLOCKED)
# =====================================================================

# ===== AI/ML API ($5K cash prize for best use) =====
# Sign up: https://aimlapi.com
# OpenAI-SDK-compatible. Unified gateway to 100+ models.
# Enables multi-model consensus voting for hallucination detection.
AIMLAPI_KEY=
AIMLAPI_MODEL=openai/gpt-5-chat-latest

# ===== Cognee (1yr Team Access $2,400 + $500 Amazon GC) =====
# Sign up: https://cognee.ai  (or self-host with: pip install cognee)
# Agent memory layer. Set BASE_URL + EITHER api_key (managed cloud)
# OR username/password (self-hosted JWT).
COGNEE_BASE_URL=
COGNEE_API_KEY=
# COGNEE_USERNAME=
# COGNEE_PASSWORD=
COGNEE_DATASET=lex_ny

# ===== Speechmatics (first 100 participants: $200 free credits) =====
# Sign up: https://www.speechmatics.com
# Voice input for legal research. Code stub only - UI work pending.
SPEECHMATICS_API_KEY=
SPEECHMATICS_LANGUAGE=en

# ===== Triggerware (partner-tier challenge rewards) =====
# Sign up: TBD - see lablab.ai partner page
# Workflow automation. Code stub only - implementation pending.
TRIGGERWARE_API_KEY=
