# Lex.NY environment variables — example template.
# Copy to nota-lex/.env.local and fill in your own keys.
# NEVER commit .env.local — it contains real credentials.

# ===================== Database (local Postgres 18 + pgvector 0.8.2) =====================
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=changeme
PGDATABASE=lex

# ===================== LLM (Groq Llama 3.3 70B) =====================
# Get free key at https://console.groq.com
GROQ_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# ===================== Embeddings (local Ollama) =====================
# Install Ollama at https://ollama.com, then: ollama pull mxbai-embed-large
OLLAMA_EMBED_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=mxbai-embed-large

# ===================== Bright Data (HACKATHON SPONSOR — required) =====================
# Get API token at https://brightdata.com/cp/setting/users (create a Web Unlocker zone)
BRIGHT_DATA_API_TOKEN=
BRIGHT_DATA_WEB_UNLOCKER_ZONE=mcp_unlocker
BRIGHT_DATA_SERP_ZONE=mcp_unlocker
WEB_DATA_PROVIDER=brightdata

# ===================== Neo4j AuraDB (HACKATHON SPONSOR — optional but adds GraphRAG) =====================
# Get free instance at https://console.neo4j.io
# When unset, /api/ask still works — graph augmentation is skipped gracefully.
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ===================== Algolia (HACKATHON SPONSOR — optional federated search) =====================
# Get free Build tier at https://www.algolia.com
ALGOLIA_APP_ID=
ALGOLIA_ADMIN_API_KEY=
ALGOLIA_SEARCH_API_KEY=
ALGOLIA_INDEX_NAME=lex_ny_statutes

# ===================== Storyblok (HACKATHON SPONSOR — optional CMS for blog) =====================
# 45-day Growth+ trial at https://www.storyblok.com
STORYBLOK_ACCESS_TOKEN=
STORYBLOK_SPACE_ID=

# ===================== Source data APIs (all free) =====================
# CourtListener — free tier 5 req/min on opinion endpoints (May 2026)
# https://www.courtlistener.com/help/api/rest/
COURTLISTENER_API_TOKEN=

# NY Senate OpenLegislation — free, register at https://legislation.nysenate.gov/static/docs/html/index.html
NY_SENATE_API_KEY=
