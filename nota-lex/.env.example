# ============================================================
#  Lex.NY - environment variables
#  Copy to .env.local and fill in real values
# ============================================================

# --- Supabase (corpus storage + auth) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...
SUPABASE_SERVICE_ROLE_KEY=ey...

# --- LLM (answer generation) ---
# Groq for demo speed (~500 tok/s on Llama 3.3 70B Versatile).
# Flip LLM_PROVIDER=ollama to route to Johnson's local Qwen3 instead (slower
# but no external dependency; useful if Groq is down).
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# Local Ollama fallback (Johnson's RTX 3090, Qwen3 32B)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:30b-a3b-instruct-2507-q4_K_M

# --- Embeddings (vector retrieval) ---
# 100% local via Ollama. No outside API key needed. Free, runs on Johnson's GPU.
# Model: mxbai-embed-large (1024 dims). Pulled via:
#   ollama pull mxbai-embed-large
OLLAMA_EMBED_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=mxbai-embed-large

# --- Web data provider (scraping + live SERP) ---
WEB_DATA_PROVIDER=brightdata

# Bright Data (required - this is the hackathon)
BRIGHT_DATA_API_TOKEN=...
BRIGHT_DATA_WEB_UNLOCKER_ZONE=mcp_unlocker
BRIGHT_DATA_SERP_ZONE=serp

# Nimble (optional fallback - kept for cross-submit optionality)
NIMBLE_EMAIL=
NIMBLE_PASSWORD=

# --- Free legal data sources ---
# CourtListener API token (free, for case-law seeding)
# https://www.courtlistener.com/profile/api/
COURTLISTENER_API_TOKEN=

# NY State Senate OpenLegislation API key (free, for statute seeding)
# https://legislation.nysenate.gov
NY_SENATE_API_KEY=
